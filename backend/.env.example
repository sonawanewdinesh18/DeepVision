# =============================================================================
# DeepVision Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=DeepVision API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# ── CORS / Security ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or '*' for public access
# Examples: http://localhost:5173,http://localhost:3000,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Supabase Backend Credentials ────────────────────────────────────────────
# Find in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Supabase Storage bucket for detection media (must be set to Public or have RLS)
SUPABASE_STORAGE_BUCKET=detection-media

# ── AI Model Configuration ──────────────────────────────────────────────────
# Path to the trained HybridViTCNN weights (.pth)
# Can be absolute, or relative to the backend root or monorepo root
MODEL_PATH=./models/Hybrid_vit.pth
DEVICE=auto
CONFIDENCE_THRESHOLD=0.5
VIDEO_SAMPLE_FRAMES=16
