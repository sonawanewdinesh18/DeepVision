# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=pronunex-dB
USE_SUPABASE_STORAGE=true
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Database
DATABASE_URL=postgresql://user:password@host:port/database
dB_password=your_database_password

# Frontend
FRONTEND_URL=http://localhost:5173

# Sightengine API Configuration (for deepfake detection)
# Sign up at https://sightengine.com/ to get your API credentials
# Free tier: 2,000 operations/month
SIGHTENGINE_API_USER=your_sightengine_api_user
SIGHTENGINE_API_SECRET=your_sightengine_api_secret

# Optional: CUDA support for local models (if not using Sightengine)
CUDA_AVAILABLE=false
