# Compiled Python
__pycache__/
*.py[cod]
*$py.class

# Environments - CRITICAL: Keep these ignored!
.env
.env.local
.env.*.local
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
dvvenv/
backend/.env
frontend/.env

